# Homebrew formula for vi-mcp — generated by deploy/macos/build.sh from deploy/macos/vi-mcp.rb.in (version and checksum filled in).
# Install:  brew tap imoes/vi-mcp && brew install vi-mcp
# The source archive is the signed release asset vi-mcp-<version>.tar.gz (listed in the release's SHA256SUMS).
class ViMcp < Formula
  desc "VI memory as an MCP server for many AI sessions (Streamable HTTP, one process)"
  homepage "https://github.com/imoes/vi-mcp"
  url "https://github.com/imoes/vi-mcp/releases/download/v@VERSION@/vi-mcp-@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "AGPL-3.0-or-later"

  depends_on "python@3.13"

  # The same PyPI packages as the Windows installer (deploy/windows/install.ps1); binary wheels exist for macOS arm64 and x86_64.
  PYPI = ["numpy>=1.26", "scikit-learn>=1.4", "cryptography>=41", "pyyaml>=6", "pypdf>=3.4", "clingo==5.8.3"].freeze

  def install
    python = Formula["python@3.13"].opt_bin/"python3.13"
    venv = libexec/"venv"
    system python, "-m", "venv", venv
    system venv/"bin/python", "-m", "pip", "install", "--disable-pip-version-check", "--no-input", "--only-binary=:all:", *PYPI
    # the code lives next to the venv (as on Arch and Windows): a .pth file puts it on sys.path, also with python -I
    (libexec/"lib").install "vi_mcp", "clingo_object"
    (libexec/"lib/hook").install "hook/vi_hook.py"   # setup finds the hook next to the package (setup.hook_path)
    site = Utils.safe_popen_read(venv/"bin/python", "-c", "import sysconfig; print(sysconfig.get_paths()['purelib'])").strip
    (Pathname(site)/"vi-mcp.pth").write "#{libexec}/lib\n"
    (bin/"vi-mcp").write <<~SH
      #!/bin/sh
      # vi-mcp — start the server, create an instance, set up clients. Configuration: $VI_MCP_CONFIG or ~/.config/vi-mcp/config.json
      export VI_P2P_DIR="${VI_P2P_DIR:-#{etc}/vi-p2p}"
      exec "#{venv}/bin/python" -I -m vi_mcp "$@"
    SH
    doc.install "README.md", "README.de.md", "AGENTS.md", "CHANGELOG.md"
  end

  service do
    run [opt_bin/"vi-mcp"]
    keep_alive true
    log_path var/"log/vi-mcp.log"
    error_log_path var/"log/vi-mcp.log"
  end

  def caveats
    <<~EOS
      Create an instance (prints its token once), start the server, register your AI clients:
        vi-mcp instance "$USER" --reflexes
        brew services start vi-mcp
        vi-mcp setup
      Configuration: ~/.config/vi-mcp/config.json · memory: ~/.local/share/vi-mcp/vi.db · log: #{var}/log/vi-mcp.log
      Not on macOS yet: the network service (vi-p2p) and the own embedding service (vi-mcp embed) — both need systemd.
    EOS
  end

  test do
    assert_equal version.to_s,
      shell_output("#{libexec}/venv/bin/python -I -c 'import vi_mcp, clingo, sklearn; print(vi_mcp.__version__)'").strip
    ENV["VI_MCP_CONFIG"] = testpath/"config.json"
    (testpath/"config.json").write({ port: free_port, db: (testpath/"vi.db").to_s }.to_json)
    assert_match "brewtest", shell_output("#{bin}/vi-mcp instance brewtest 2>&1 >/dev/null; cat #{testpath}/config.json")
  end
end
