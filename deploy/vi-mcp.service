[Unit]
Description=vi-mcp — VI memory as an MCP server (Streamable HTTP, one process)
Documentation=file://%h/Dev/code/vi-mcp/README.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Dev/code/vi-mcp
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m vi_mcp
Restart=on-failure
RestartSec=5
# SIGTERM → open conversations are saved as interrupted, the WAL is checkpointed
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
