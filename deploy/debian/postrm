#!/bin/sh
# Memory (/var/lib/vi-mcp) and configuration (/etc/vi-mcp) stay on remove; purge deletes them.
set -e
if [ "$1" = "remove" ]; then
    systemctl disable vi-mcp.service vi-p2p.service >/dev/null 2>&1 || true
    for u in $(systemctl list-unit-files 'vi-p2p@*.service' --no-legend 2>/dev/null | awk '{print $1}'); do systemctl disable "$u" >/dev/null 2>&1 || true; done
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ]; then
    if [ -e /usr/share/debconf/confmodule ]; then . /usr/share/debconf/confmodule; db_purge || true; db_stop || true; fi
    rm -rf /etc/vi-mcp /var/lib/vi-mcp /etc/vi-p2p /var/lib/vi-p2p
    getent passwd vi-p2p >/dev/null && deluser --system vi-p2p >/dev/null 2>&1 || true
    getent passwd vi-mcp >/dev/null && deluser --system vi-mcp >/dev/null 2>&1 || true
fi
exit 0
