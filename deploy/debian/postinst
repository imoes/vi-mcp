#!/bin/sh
# vi-mcp postinst: Systemnutzer, dann das Gemeinsame; bei der Erstinstallation das Menü.
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd vi-mcp >/dev/null; then
        adduser --system --group --home /var/lib/vi-mcp --no-create-home --gecos "vi-mcp VI-Gedaechtnis" vi-mcp
    fi
    /usr/share/vi-mcp/nach-installation.sh system
    if [ -z "$2" ]; then
        /usr/share/vi-mcp/nach-installation.sh menue
    fi
fi
exit 0
