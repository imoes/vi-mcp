# Maintainer: vi-mcp project <https://github.com/imoes/vi-mcp>
# Generated by deploy/arch/build.sh from PKGBUILD.in (version and checksum filled in).
pkgname=vi-mcp
pkgver=@VERSION@
pkgrel=@REL@
pkgdesc="VI memory as an MCP server for many AI sessions (Streamable HTTP, one process)"
arch=('any')
url="https://github.com/imoes/vi-mcp"
license=('AGPL-3.0-or-later')
depends=('python>=3.11' 'python-numpy' 'python-scikit-learn' 'python-cryptography' 'python-yaml' 'python-pypdf' 'systemd')
optdepends=('clingo: the logic layer vi_logic and philosophy packages (AUR; without it: sudo vi-mcp logic install, needs python-pip)'
            'python-pip: sudo vi-mcp logic install fetches clingo into /var/lib/vi-mcp when no clingo package is installed'
            'python-psycopg: PostgreSQL instead of SQLite'
            'libtorrent-rasterbar: large network transfers by torrent'
            'libreoffice-fresh: documentation import of legacy formats (doc, xls, ppt, rtf)')
backup=()
install=vi-mcp.install
source=("vi-mcp-$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "$srcdir/vi-mcp-$pkgver"
    install -d "$pkgdir/usr/lib/vi-mcp/vi_mcp" "$pkgdir/usr/lib/vi-mcp/clingo_object" "$pkgdir/usr/bin" "$pkgdir/usr/lib/systemd/system" \
               "$pkgdir/usr/share/doc/vi-mcp/docs" "$pkgdir/usr/share/vi-mcp/hook" "$pkgdir/usr/lib/sysusers.d" "$pkgdir/usr/share/licenses/vi-mcp"
    install -m 0644 vi_mcp/*.py "$pkgdir/usr/lib/vi-mcp/vi_mcp/"
    install -m 0644 clingo_object/*.py "$pkgdir/usr/lib/vi-mcp/clingo_object/"
    install -m 0755 deploy/arch/vi-mcp-start "$pkgdir/usr/lib/vi-mcp/vi-mcp-start"
    install -m 0755 deploy/arch/vi-mcp.sh "$pkgdir/usr/bin/vi-mcp"
    sed 's#^ExecStart=.*#ExecStart=/usr/lib/vi-mcp/vi-mcp-start#' deploy/debian/vi-mcp.service > "$pkgdir/usr/lib/systemd/system/vi-mcp.service"
    chmod 0644 "$pkgdir/usr/lib/systemd/system/vi-mcp.service"
    install -m 0644 deploy/vi-p2p.service deploy/vi-p2p@.service "$pkgdir/usr/lib/systemd/system/"
    install -m 0644 deploy/arch/vi-mcp.sysusers "$pkgdir/usr/lib/sysusers.d/vi-mcp.conf"
    install -m 0644 README.md README.de.md AGENTS.md CHANGELOG.md "$pkgdir/usr/share/doc/vi-mcp/"
    # docs/LOKAL* holds host details and must never go into a package (build.sh leaves them out of the source archive)
    find docs -maxdepth 1 -name "*.md" ! -name "LOKAL*" -exec install -m 0644 {} "$pkgdir/usr/share/doc/vi-mcp/docs/" \;
    install -m 0755 hook/vi_hook.py "$pkgdir/usr/share/vi-mcp/hook/vi_hook.py"
    install -m 0755 deploy/nach-installation.sh "$pkgdir/usr/share/vi-mcp/nach-installation.sh"
    [ -f LICENSE ] && install -m 0644 LICENSE "$pkgdir/usr/share/licenses/vi-mcp/LICENSE"
    return 0
}
